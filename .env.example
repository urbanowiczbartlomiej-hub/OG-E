# Release credentials for `npm run release` (the npm script auto-loads .env when
# present). Copy this file to .env (gitignored) and fill in the values. Never
# commit .env.
#
#   npm run release 1.25.1
#
# Each store's upload is skipped independently when its creds are absent, so you
# can fill in only the store(s) you publish to.

# --- AMO (addons.mozilla.org) ---
# Generate a key pair at https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=user:000000:000
AMO_JWT_SECRET=

# --- Chrome Web Store ---
# The item must already exist on the CWS (the API updates a listing, it can't
# create one). CWS_EXTENSION_ID is the item id from the dashboard URL. The OAuth
# trio comes from a Google Cloud OAuth client with the "Chrome Web Store API"
# enabled; mint the refresh token once against that client.
CWS_EXTENSION_ID=
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
