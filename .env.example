# AMO (addons.mozilla.org) API credentials for `npm run release`.
# Generate a key pair at https://addons.mozilla.org/developers/addon/api/key/
# Copy this file to .env (gitignored) and fill in the values. Never commit .env.
#
# Run a release with the env loaded:
#   node --env-file=.env scripts/release.mjs 1.10.0

AMO_JWT_ISSUER=user:000000:000
AMO_JWT_SECRET=
